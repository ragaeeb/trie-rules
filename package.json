{
    "name": "trie-rules",
    "version": "3.2.0",
    "description": "Performs fast search and replace on a text based on a set of rules.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "source": "src/index.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ragaeeb/trie-rules.git"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist/**"
    ],
    "private": false,
    "type": "module",
    "homepage": "https://github.com/ragaeeb/trie-rules",
    "scripts": {
        "benchmark": "esbench",
        "build": "tsdown",
        "lint": "biome lint --reporter=summary",
        "format": "biome format",
        "test": "bun test --coverage --coverage-reporter=lcov"
    },
    "engines": {
        "bun": ">=1.2.20",
        "node": ">=22.0.0"
    },
    "keywords": [
        "search",
        "replace",
        "trie"
    ],
    "author": "Ragaeeb Haq",
    "license": "MIT",
    "devDependencies": {
        "@biomejs/biome": "^2.3.5",
        "@types/bun": "^1.3.2",
        "@types/node": "^24.10.1",
        "esbench": "^0.8.0",
        "semantic-release": "^25.0.2",
        "tsdown": "^0.16.4"
    }
}
