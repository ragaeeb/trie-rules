{
  "author": "Ragaeeb Haq",
  "description": "Performs fast search and replace on a text based on a set of rules.",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "esbench": "^0.8.1",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.23.0"
  },
  "engines": {
    "bun": ">=1.3.9",
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.MD"
  ],
  "homepage": "https://github.com/ragaeeb/trie-rules",
  "keywords": [
    "search",
    "replace",
    "trie"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "trie-rules",
  "packageManager": "bun@1.3.9",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ragaeeb/trie-rules.git"
  },
  "scripts": {
    "benchmark": "esbench",
    "build": "tsdown",
    "format": "biome format",
    "lint": "biome lint --reporter=summary",
    "postbuild": "bun run test:exports",
    "test:exports": "bunx tsc --ignoreConfig --noEmit testing/exports.test.ts --moduleResolution bundler --target esnext --module esnext --esModuleInterop --skipLibCheck --types bun-types,node && bun test testing/exports.test.ts"
  },
  "source": "src/index.ts",
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "3.3.1"
}
