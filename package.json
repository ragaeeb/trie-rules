{
    "name": "trie-rules",
    "version": "3.2.0",
    "description": "Performs fast search and replace on a text based on a set of rules.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "source": "src/index.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ragaeeb/trie-rules.git"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist/**"
    ],
    "private": false,
    "type": "module",
    "homepage": "https://github.com/ragaeeb/trie-rules",
    "scripts": {
        "benchmark": "esbench",
        "build": "tsup",
        "test": "bun test --coverage --coverage-reporter=lcov"
    },
    "engines": {
        "bun": ">=1.2.20",
        "node": ">=22.0.0"
    },
    "keywords": [
        "search",
        "replace",
        "trie"
    ],
    "author": "Ragaeeb Haq",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^9.34.0",
        "@types/bun": "^1.2.20",
        "@types/node": "^24.3.0",
        "esbench": "^0.8.0",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-perfectionist": "^4.15.0",
        "eslint-plugin-prettier": "^5.5.4",
        "globals": "^16.3.0",
        "prettier": "^3.6.2",
        "semantic-release": "^24.2.7",
        "tsup": "^8.5.0",
        "typescript-eslint": "^8.40.0"
    }
}
